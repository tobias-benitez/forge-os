from datetime import time
from app.database import SessionLocal
from app.models.core import User, RoutineBlock, DayOfWeek, BlockCategory

def populate_routine():
    db = SessionLocal()
    try:
        user = db.query(User).first()
        if not user:
            print("No se encontró usuario. Creando usuario por defecto...")
            user = User(name="Tobías", phone="541123588856", xp_total=0)
            db.add(user)
            db.commit()
            db.refresh(user)

        # Limpiar bloques anteriores para no duplicar
        db.query(RoutineBlock).filter(RoutineBlock.user_id == user.id).delete()

        bloques = [
            # LUNES
            (DayOfWeek.MONDAY, time(8, 0), 240, BlockCategory.ACADEMIC, "Cursada Programación"),
            (DayOfWeek.MONDAY, time(13, 0), 45, BlockCategory.UPSKILLING, "Viaje de vuelta // Podcast en inglés"),
            (DayOfWeek.MONDAY, time(17, 0), 90, BlockCategory.FITNESS, "Entrenamiento / Gimnasio"),
            (DayOfWeek.MONDAY, time(19, 0), 120, BlockCategory.ACADEMIC, "Bloque Estudio // Repaso"),

            # MARTES
            (DayOfWeek.TUESDAY, time(9, 0), 120, BlockCategory.ACADEMIC, "Bloque Estudio // Física II"),
            (DayOfWeek.TUESDAY, time(17, 0), 90, BlockCategory.FITNESS, "Entrenamiento / Gimnasio"),

            # MIÉRCOLES
            (DayOfWeek.WEDNESDAY, time(8, 0), 240, BlockCategory.ACADEMIC, "Cursada Facultad"),
            (DayOfWeek.WEDNESDAY, time(17, 0), 90, BlockCategory.FITNESS, "Entrenamiento / Gimnasio"),

            # JUEVES
            (DayOfWeek.THURSDAY, time(9, 0), 120, BlockCategory.ACADEMIC, "Bloque Estudio // Teoría de Lenguajes"),
            (DayOfWeek.THURSDAY, time(17, 0), 90, BlockCategory.FITNESS, "Entrenamiento / Gimnasio"),

            # VIERNES
            (DayOfWeek.FRIDAY, time(8, 0), 240, BlockCategory.ACADEMIC, "Cursada Física II (4 horas)"),
            (DayOfWeek.FRIDAY, time(13, 0), 45, BlockCategory.UPSKILLING, "Viaje de vuelta // Podcast en inglés"),
            (DayOfWeek.FRIDAY, time(17, 0), 90, BlockCategory.FITNESS, "Entrenamiento / Gimnasio"),

            # SÁBADO
            (DayOfWeek.SATURDAY, time(10, 0), 90, BlockCategory.FITNESS, "Entrenamiento / Actividad física"),
            (DayOfWeek.SATURDAY, time(15, 0), 60, BlockCategory.READING, "Lectura // 'Cómo ganar amigos'"),

            # DOMINGO (HOY)
            (DayOfWeek.SUNDAY, time(12, 30), 120, BlockCategory.HOUSEHOLD, "Almuerzo familiar / Asado"),
            (DayOfWeek.SUNDAY, time(17, 0), 60, BlockCategory.READING, "Lectura formativa (20 págs)"),
            (DayOfWeek.SUNDAY, time(19, 30), 60, BlockCategory.ACADEMIC, "Planificación semanal y armado de mochila/repaso"),
        ]

        for dow, t_start, dur, cat, label in bloques:
            b = RoutineBlock(
                user_id=user.id,
                day_of_week=dow,
                start_time=t_start,
                duration_minutes=dur,
                category=cat,
                label=label
            )
            db.add(b)

        db.commit()
        print(f"¡Éxito! Se cargaron {len(bloques)} bloques de rutina para toda la semana.")
    finally:
        db.close()

if __name__ == "__main__":
    populate_routine()